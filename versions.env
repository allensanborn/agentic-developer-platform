# Every external version the platform installs. One file so a bump is one reviewed diff.
# The `# renovate:` comment above each line tells Renovate where to look (renovate.json5).
CLUSTER=adp
# renovate: datasource=docker depName=rancher/k3s versioning=regex:^v(?<major>\d+)\.(?<minor>\d+)\.(?<patch>\d+)-k3s(?<build>\d+)$
K3S_IMAGE=rancher/k3s:v1.35.10-k3s1
# renovate: datasource=github-releases depName=kubernetes-sigs/gateway-api
GATEWAY_API_VERSION=v1.7.0
# renovate: datasource=docker depName=ghcr.io/agentgateway/charts/agentgateway
AGENTGATEWAY_VERSION=v1.7.0
# renovate: datasource=docker depName=ghcr.io/external-secrets/charts/external-secrets
EXTERNAL_SECRETS_VERSION=2.15.0
# renovate: datasource=helm depName=dapr registryUrl=https://dapr.github.io/helm-charts
DAPR_VERSION=1.19.1
# renovate: datasource=helm depName=vpa registryUrl=https://charts.fairwinds.com/stable
VPA_CHART_VERSION=5.2.0
