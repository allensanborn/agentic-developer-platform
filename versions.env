# Every external version the platform installs. One file so a bump is one reviewed diff.
# The `# renovate:` comment above each line tells Renovate where to look (renovate.json5).
CLUSTER=adp
# renovate: datasource=docker depName=rancher/k3s versioning=regex:^v(?<major>\d+)\.(?<minor>\d+)\.(?<patch>\d+)-k3s(?<build>\d+)$
K3S_IMAGE=rancher/k3s:v1.35.10-k3s1
# renovate: datasource=github-releases depName=kubernetes-sigs/gateway-api
GATEWAY_API_VERSION=v1.7.0
# renovate: datasource=docker depName=ghcr.io/agentgateway/charts/agentgateway
AGENTGATEWAY_VERSION=v1.7.0
# renovate: datasource=docker depName=ghcr.io/external-secrets/charts/external-secrets
EXTERNAL_SECRETS_VERSION=2.15.0
# renovate: datasource=helm depName=dapr registryUrl=https://dapr.github.io/helm-charts
DAPR_VERSION=1.19.1
# renovate: datasource=helm depName=vpa registryUrl=https://charts.fairwinds.com/stable
VPA_CHART_VERSION=5.2.0
# renovate: datasource=helm depName=cilium registryUrl=https://helm.cilium.io
CILIUM_VERSION=1.20.4
# SPIRE issues every workload an SVID (ADR 0025). The hardened charts: CRDs, then the stack.
# renovate: datasource=helm depName=spire-crds registryUrl=https://spiffe.github.io/helm-charts-hardened
SPIRE_CRDS_VERSION=0.6.1
# renovate: datasource=helm depName=spire registryUrl=https://spiffe.github.io/helm-charts-hardened
SPIRE_VERSION=0.31.0
# The host's GPU model behind `smart` (ADR 0018, scripts/host-model.sh). Pinned by the sha256 of
# its Ollama manifest; Renovate cannot see it, so a bump is by hand: pull, then update both.
HOST_MODEL=llama3.2:3b
HOST_MODEL_DIGEST=a52a4a87c5affc63e344f4974f75bcc5b478b40e641df57d0f40941dfc406c94
# The host model behind `diagnose`, the ERP agent's fix selection (ADR 0024). Same pinning.
HOST_DIAGNOSIS_MODEL=llama3.1:8b
HOST_DIAGNOSIS_MODEL_DIGEST=3fc95d284915704cf140b825abf5150af0d32fde95f55c081c9602d49d4547c0
